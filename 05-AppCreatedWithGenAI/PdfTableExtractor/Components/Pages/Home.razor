@page "/"
@rendermode InteractiveServer
@using PdfTableExtractor.Services
@using PdfTableExtractor.Models
@using Microsoft.AspNetCore.Components.Forms
@inject PdfService PdfService
@inject AiExtractorService AiService
@inject ExcelExportService ExcelService
@inject IJSRuntime JS
@using System.IO

<PageTitle>Smart PDF Table Extractor</PageTitle>

<div class="container mt-4 animate__animated animate__fadeIn">
    <div class="row">
        <div class="col-md-12 text-center mb-4">
            <h1 class="display-5 fw-bold text-primary"><i class="bi bi-file-earmark-excel-fill me-2"></i>Smart PDF Table Extractor</h1>
            <p class="lead">Extracción inteligente y selectiva de tablas hacia Excel usando IA (GPT-4o).</p>
        </div>
    </div>

    @* Paso 1: Carga de Archivo *@
    <div class="card mb-4 shadow-sm border-0">
        <div class="card-header bg-white border-0 py-3">
            <h5 class="card-title mb-0 fw-bold"><i class="bi bi-1-circle-fill text-primary me-2"></i>1. Cargar PDF</h5>
        </div>
        <div class="card-body pt-0">
            <div class="upload-container p-4 border-2 border-dashed rounded-3 text-center bg-light">
                <InputFile OnChange="OnInputFileChange" class="form-control" id="pdfUpload" accept=".pdf" hidden />
                <label for="pdfUpload" class="btn btn-outline-primary btn-lg px-5 cursor-pointer">
                    <i class="bi bi-cloud-arrow-up-fill me-2"></i>Seleccionar Archivo PDF
                </label>
                @if (selectedFile != null)
                {
                    <div class="mt-3 text-success">
                        <i class="bi bi-file-check-fill me-2"></i><strong>Archivo cargado:</strong> @selectedFile.Name (@(selectedFile.Size / 1024) KB)
                    </div>
                }
            </div>
            @if (isUploading)
            {
                <div class="mt-3 text-center text-primary">
                    <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                    <strong>Analizando documento...</strong>
                </div>
            }
        </div>
    </div>

    @* Paso 2: Selección y Previsualización *@
    @if (pdfPages > 0)
    {
        <div class="card mb-4 shadow-sm border-0 animate__animated animate__fadeIn">
            <div class="card-header bg-white border-0 py-3">
                <h5 class="card-title mb-0 fw-bold"><i class="bi bi-2-circle-fill text-primary me-2"></i>2. Seleccionar Páginas y Procesar</h5>
            </div>
            <div class="card-body pt-0">
                <div class="row mb-4">
                    <div class="col-lg-6">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label fw-bold mb-0">Seleccione las páginas con tablas:</label>
                            <div class="btn-group">
                                <button class="btn btn-link btn-sm text-decoration-none" @onclick="SelectAllPages">Todas</button>
                                <button class="btn btn-link btn-sm text-decoration-none text-danger" @onclick="DeselectAllPages">Ninguna</button>
                            </div>
                        </div>
                        <div class="page-selector d-flex flex-wrap gap-2 border rounded-3 p-3 bg-white" style="max-height: 280px; overflow-y: auto;">
                            @for (int i = 1; i <= pdfPages; i++)
                            {
                                int pageNum = i;
                                <div class="page-item">
                                    <input type="checkbox" class="btn-check" id="page_@pageNum" autocomplete="off"
                                           checked="@selectedPages.Contains(pageNum)"
                                           @onchange="@(e => TogglePage(pageNum, e))">
                                    <label class="btn btn-outline-primary btn-sm page-label" for="page_@pageNum">@pageNum</label>
                                </div>
                            }
                        </div>
                        <div class="mt-3 p-2 bg-light rounded text-center small">
                             <strong>Selección:</strong> @selectedPages.Count @(selectedPages.Count == 1 ? "página" : "páginas") de @pdfPages
                        </div>
                    </div>
                    <div class="col-lg-6 mt-4 mt-lg-0 border-start ps-lg-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label fw-bold mb-0">Vista Previa:</label>
                            <span class="badge bg-secondary">Página @previewPage de @pdfPages</span>
                        </div>
                        <div id="pdf-viewer-container" class="border rounded-3 bg-dark overflow-hidden position-relative shadow-inner" style="height: 280px;">
                            <div id="pdf-viewer" class="w-100 h-100 d-flex justify-content-center align-items-center overflow-auto p-2">
                                <canvas id="pdf-canvas" class="shadow-sm"></canvas>
                                @if (isPreviewLoading)
                                {
                                    <div class="position-absolute top-50 start-50 translate-middle bg-white p-3 rounded-circle shadow">
                                        <div class="spinner-border text-primary" role="status"></div>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="mt-2 d-flex justify-content-center gap-2">
                             <button class="btn btn-sm btn-outline-secondary" @onclick="PrevPreview" disabled="@(previewPage <= 1 || isPreviewLoading)">
                                 <i class="bi bi-chevron-left"></i> Anterior
                             </button>
                             <button class="btn btn-sm btn-outline-secondary" @onclick="NextPreview" disabled="@(previewPage >= pdfPages || isPreviewLoading)">
                                 Siguiente <i class="bi bi-chevron-right"></i>
                             </button>
                        </div>
                    </div>
                </div>

                <div class="mt-4">
                    <button class="btn btn-primary btn-lg w-100 shadow py-3 fw-bold" @onclick="ProcessPdf" disabled="@(selectedPages.Count == 0 || isProcessing)">
                        @if (isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Procesando con Inteligencia Artificial...</span>
                        }
                        else
                        {
                            <span><i class="bi bi-lightning-charge-fill me-2"></i>Iniciar Extracción de Tablas</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }

    @* Paso 3: Resultados *@
    @if (extractionResult != null)
    {
        <div class="card mb-4 shadow border-0 border-top border-4 border-success animate__animated animate__fadeInUp">
            <div class="card-body">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3 border-bottom pb-3">
                    <h5 class="card-title text-success mb-0 fw-bold"><i class="bi bi-3-circle-fill me-2"></i>3. Resultados y Exportación</h5>
                    <button class="btn btn-success btn-lg px-4 shadow-sm fw-bold" @onclick="DownloadExcel">
                        <i class="bi bi-file-earmark-spreadsheet-fill me-2"></i>Descargar Excel (.xlsx)
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(extractionResult.Summary))
                {
                    <div class="alert alert-primary bg-opacity-10 border-0 mb-4 d-flex">
                        <i class="bi bi-info-circle-fill me-3 fs-4 text-primary"></i>
                        <div>
                            <h6 class="fw-bold mb-1 text-primary">Resumen del Procesamiento:</h6>
                            <p class="mb-0 text-dark">@extractionResult.Summary</p>
                        </div>
                    </div>
                }

                @if (extractionResult.Tables.Count == 0)
                {
                    <div class="text-center my-5 p-5 bg-light rounded-3">
                        <i class="bi bi-search fs-1 text-muted mb-3 d-block"></i>
                        <p class="text-muted fs-5">No se detectaron tablas estructuradas en las páginas seleccionadas.</p>
                    </div>
                }

                @foreach (var table in extractionResult.Tables)
                {
                    <div class="table-card mb-5 animate__animated animate__fadeIn">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-primary bg-opacity-10 text-primary p-2 rounded-circle me-3">
                                <i class="bi bi-grid-3x3"></i>
                            </div>
                            <h6 class="fw-bold text-dark mb-0 fs-5">@table.TableName</h6>
                        </div>
                        <div class="table-container shadow-sm border rounded-3 overflow-hidden">
                            <div class="table-responsive" style="max-height: 450px;">
                                <table class="table table-hover table-striped bg-white mb-0 align-middle">
                                    <thead class="table-primary border-bottom">
                                        <tr>
                                            @foreach (var header in table.Headers)
                                            {
                                                <th class="py-3 px-3">@header</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody class="border-top-0">
                                        @foreach (var row in table.Rows)
                                        {
                                            <tr>
                                                @foreach (var cell in row)
                                                {
                                                    <td class="py-2 px-3 border-bottom-0">@cell</td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @* Alertas de Error *@
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger shadow border-0 border-start border-4 border-danger animate__animated animate__shakeX">
             <div class="d-flex align-items-center">
                 <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                 <div>
                     <h6 class="fw-bold mb-1">Error</h6>
                     <p class="mb-0 small">@errorMessage</p>
                 </div>
             </div>
        </div>
    }
</div>

<style>
    .cursor-pointer { cursor: pointer; }
    .border-dashed { border-style: dashed !important; }
    .shadow-inner { box-shadow: inset 0 2px 4px 0 rgba(0, 0, 0, 0.06) !important; }
    .page-label { min-width: 45px; height: 45px; display: flex; align-items: center; justify-content: center; font-weight: bold; }
    .btn-check:checked + .page-label { background-color: #0d6efd; border-color: #0d6efd; color: white; transform: scale(1.05); }
    .table-container::-webkit-scrollbar { width: 8px; height: 8px; }
    .table-container::-webkit-scrollbar-track { background: #f1f1f1; }
    .table-container::-webkit-scrollbar-thumb { background: #ccc; border-radius: 4px; }
    .table-container::-webkit-scrollbar-thumb:hover { background: #bbb; }
    .upload-container:hover { border-color: #0d6efd !important; background-color: #f8f9ff !important; transition: all 0.3s ease; }
</style>

@code {
    private bool isUploading = false;
    private bool isProcessing = false;
    private bool isPreviewLoading = false;
    private int pdfPages = 0;
    private int previewPage = 1;
    private List<int> selectedPages = new();
    private byte[]? pdfBytes;
    private ExtractionResult? extractionResult;
    private string? errorMessage;
    private IBrowserFile? selectedFile;

    private async Task OnInputFileChange(InputFileChangeEventArgs e)
    {
        try
        {
            isUploading = true;
            errorMessage = null;
            extractionResult = null;
            pdfPages = 0;
            selectedPages.Clear();
            selectedFile = e.File;

            if (selectedFile != null)
            {
                if (selectedFile.Size > 20 * 1024 * 1024)
                {
                    errorMessage = "El archivo es demasiado grande. El límite es 20MB.";
                    selectedFile = null;
                    return;
                }

                using var stream = selectedFile.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
                using var memoryStream = new MemoryStream();
                await stream.CopyToAsync(memoryStream);
                pdfBytes = memoryStream.ToArray();

                pdfPages = PdfService.GetPageCount(new MemoryStream(pdfBytes));
                selectedPages = Enumerable.Range(1, pdfPages).ToList();
                previewPage = 1;

                await InvokeAsync(StateHasChanged);

                try
                {
                    isPreviewLoading = true;
                    await JS.InvokeVoidAsync("pdfInterop.loadPdf", pdfBytes);
                    await JS.InvokeVoidAsync("pdfInterop.renderPage", previewPage);
                }
                catch (Exception jsEx)
                {
                    Console.WriteLine($"JS Error: {jsEx.Message}");
                }
                finally
                {
                    isPreviewLoading = false;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar PDF: {ex.Message}";
            selectedFile = null;
        }
        finally
        {
            isUploading = false;
        }
    }

    private void TogglePage(int page, ChangeEventArgs e)
    {
        bool isChecked = (bool)(e.Value ?? false);
        if (isChecked)
        {
            if (!selectedPages.Contains(page)) selectedPages.Add(page);
        }
        else
        {
            selectedPages.Remove(page);
        }
    }

    private void SelectAllPages() => selectedPages = Enumerable.Range(1, pdfPages).ToList();
    private void DeselectAllPages() => selectedPages.Clear();

    private async Task PrevPreview()
    {
        if (previewPage > 1)
        {
            previewPage--;
            await UpdatePreview();
        }
    }

    private async Task NextPreview()
    {
        if (previewPage < pdfPages)
        {
            previewPage++;
            await UpdatePreview();
        }
    }

    private async Task UpdatePreview()
    {
        isPreviewLoading = true;
        try {
            await JS.InvokeVoidAsync("pdfInterop.renderPage", previewPage);
        } finally {
            isPreviewLoading = false;
        }
    }

    private async Task ProcessPdf()
    {
        if (pdfBytes == null || selectedPages.Count == 0) return;

        try
        {
            isProcessing = true;
            errorMessage = null;
            extractionResult = null;

            var extractedText = PdfService.ExtractTextFromPages(pdfBytes, selectedPages);
            extractionResult = await AiService.ExtractTablesAsync(extractedText);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al procesar con IA: {ex.Message}. Asegúrese de configurar su API Key de OpenAI.";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task DownloadExcel()
    {
        if (extractionResult == null) return;

        try
        {
            var excelBytes = ExcelService.ExportToExcel(extractionResult);
            var fileName = $"Tablas_Extraidas_{DateTime.Now:yyyyMMddHHmmss}.xlsx";
            await JS.InvokeVoidAsync("saveAsFile", fileName, Convert.ToBase64String(excelBytes));
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al generar Excel: {ex.Message}";
        }
    }
}
