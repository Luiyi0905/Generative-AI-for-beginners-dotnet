@page "/"
@rendermode InteractiveServer
@using PdfTableExtractor.Services
@using PdfTableExtractor.Models
@using Microsoft.AspNetCore.Components.Forms
@inject PdfService PdfService
@inject AiExtractorService AiService
@inject ExcelExportService ExcelService
@inject IJSRuntime JS
@using System.IO

<PageTitle>Smart PDF Table Extractor / Extractor de Tablas PDF</PageTitle>

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12 text-center mb-4">
            <h1>📄 Smart PDF Table Extractor</h1>
            <p class="lead">Extracción inteligente y selectiva de tablas desde PDF hacia Excel usando IA.</p>
        </div>
    </div>

    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <h5 class="card-title">1. Cargar PDF / Upload PDF</h5>
            <InputFile OnChange="OnInputFileChange" class="form-control" accept=".pdf" />
            @if (isUploading)
            {
                <div class="mt-2 text-info">
                    <div class="spinner-border spinner-border-sm" role="status"></div> Cargando PDF... / Loading PDF...
                </div>
            }
        </div>
    </div>

    @if (pdfPages > 0)
    {
        <div class="card mb-4 shadow-sm animate__animated animate__fadeIn">
            <div class="card-body">
                <h5 class="card-title">2. Seleccionar Páginas / Select Pages</h5>
                <p class="text-muted small">El PDF tiene @pdfPages páginas. Seleccione las que contienen las tablas que desea extraer.</p>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="btn-group mb-2 w-100">
                            <button class="btn btn-outline-secondary btn-sm" @onclick="SelectAllPages">Todas</button>
                            <button class="btn btn-outline-secondary btn-sm" @onclick="DeselectAllPages">Ninguna</button>
                        </div>
                        <div class="d-flex flex-wrap gap-2 border rounded p-3 bg-light" style="max-height: 300px; overflow-y: auto;">
                            @for (int i = 1; i <= pdfPages; i++)
                            {
                                int pageNum = i;
                                <div class="form-check p-0">
                                    <input type="checkbox" class="btn-check" id="page_@pageNum" autocomplete="off"
                                           checked="@selectedPages.Contains(pageNum)"
                                           @onchange="@(e => TogglePage(pageNum, e))">
                                    <label class="btn btn-outline-primary btn-sm mb-1" for="page_@pageNum">Pág @pageNum</label>
                                </div>
                            }
                        </div>
                        <div class="mt-2">
                             <strong>Seleccionadas:</strong> @selectedPages.Count @(selectedPages.Count == 1 ? "página" : "páginas")
                        </div>
                    </div>
                    <div class="col-md-6 border-start">
                        <h6>Vista Previa / Preview</h6>
                        <div id="pdf-viewer" style="width: 100%; height: 300px; border: 1px solid #ccc; background: #eee; overflow: auto; display: flex; justify-content: center; align-items: center; position: relative;">
                            <canvas id="pdf-canvas"></canvas>
                            @if (isPreviewLoading)
                            {
                                <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);">
                                    <div class="spinner-border text-primary" role="status"></div>
                                </div>
                            }
                        </div>
                        <div class="mt-2 d-flex justify-content-between align-items-center">
                             <button class="btn btn-sm btn-secondary" @onclick="PrevPreview" disabled="@(previewPage <= 1 || isPreviewLoading)">Anterior</button>
                             <span class="badge bg-dark">@previewPage / @pdfPages</span>
                             <button class="btn btn-sm btn-secondary" @onclick="NextPreview" disabled="@(previewPage >= pdfPages || isPreviewLoading)">Siguiente</button>
                        </div>
                    </div>
                </div>

                <div class="mt-4">
                    <button class="btn btn-primary btn-lg w-100 shadow-sm" @onclick="ProcessPdf" disabled="@(selectedPages.Count == 0 || isProcessing)">
                        @if (isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span> Procesando... (esto puede tardar unos segundos)</span>
                        }
                        else
                        {
                            <span>🚀 Iniciar Extracción con IA / Extract</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }

    @if (extractionResult != null)
    {
        <div class="card mb-4 shadow-sm border-success animate__animated animate__fadeInUp">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                    <h5 class="card-title text-success mb-0">3. Resultados de Extracción</h5>
                    <button class="btn btn-success shadow-sm" @onclick="DownloadExcel">
                        📊 Descargar Excel (.xlsx)
                    </button>
                </div>

                <div class="alert alert-info py-2">
                    <i class="bi bi-info-circle-fill me-2"></i> <strong>Resumen:</strong> @extractionResult.Summary
                </div>

                @if (extractionResult.Tables.Count == 0)
                {
                    <p class="text-warning text-center my-4">No se detectaron tablas claras en las páginas seleccionadas.</p>
                }

                @foreach (var table in extractionResult.Tables)
                {
                    <div class="mb-5">
                        <h6 class="fw-bold text-primary"><i class="bi bi-table me-2"></i>@table.TableName</h6>
                        <div class="table-responsive shadow-sm rounded" style="max-height: 400px;">
                            <table class="table table-sm table-bordered table-hover bg-white mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        @foreach (var header in table.Headers)
                                        {
                                            <th>@header</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in table.Rows)
                                    {
                                        <tr>
                                            @foreach (var cell in row)
                                            {
                                                <td>@cell</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-3 shadow-sm border-start border-4 border-danger animate__animated animate__shakeX">
             <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
        </div>
    }
</div>

<style>
    .btn-check:checked + .btn-outline-primary {
        background-color: #0d6efd;
        color: white;
        font-weight: bold;
    }
</style>

@code {
    private bool isUploading = false;
    private bool isProcessing = false;
    private bool isPreviewLoading = false;
    private int pdfPages = 0;
    private int previewPage = 1;
    private List<int> selectedPages = new();
    private byte[]? pdfBytes;
    private ExtractionResult? extractionResult;
    private string? errorMessage;

    private async Task OnInputFileChange(InputFileChangeEventArgs e)
    {
        try
        {
            isUploading = true;
            errorMessage = null;
            extractionResult = null;
            pdfPages = 0;
            selectedPages.Clear();

            var file = e.File;
            if (file != null)
            {
                if (file.Size > 20 * 1024 * 1024)
                {
                    errorMessage = "El archivo es demasiado grande. El límite es 20MB.";
                    return;
                }

                using var stream = file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
                using var memoryStream = new MemoryStream();
                await stream.CopyToAsync(memoryStream);
                pdfBytes = memoryStream.ToArray();

                pdfPages = PdfService.GetPageCount(new MemoryStream(pdfBytes));
                selectedPages = Enumerable.Range(1, pdfPages).ToList();
                previewPage = 1;

                await InvokeAsync(StateHasChanged);

                try
                {
                    isPreviewLoading = true;
                    await JS.InvokeVoidAsync("pdfInterop.loadPdf", pdfBytes);
                    await JS.InvokeVoidAsync("pdfInterop.renderPage", previewPage);
                }
                catch (Exception jsEx)
                {
                    Console.WriteLine($"JS Error: {jsEx.Message}");
                    // We don't block the UI if preview fails
                }
                finally
                {
                    isPreviewLoading = false;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar PDF: {ex.Message}";
        }
        finally
        {
            isUploading = false;
        }
    }

    private void TogglePage(int page, ChangeEventArgs e)
    {
        bool isChecked = (bool)(e.Value ?? false);
        if (isChecked && !selectedPages.Contains(page))
            selectedPages.Add(page);
        else if (!isChecked && selectedPages.Contains(page))
            selectedPages.Remove(page);

        selectedPages.Sort();
    }

    private void SelectAllPages() => selectedPages = Enumerable.Range(1, pdfPages).ToList();
    private void DeselectAllPages() => selectedPages.Clear();

    private async Task PrevPreview()
    {
        if (previewPage > 1)
        {
            previewPage--;
            await JS.InvokeVoidAsync("pdfInterop.renderPage", previewPage);
        }
    }

    private async Task NextPreview()
    {
        if (previewPage < pdfPages)
        {
            previewPage++;
            await JS.InvokeVoidAsync("pdfInterop.renderPage", previewPage);
        }
    }

    private async Task ProcessPdf()
    {
        if (pdfBytes == null || selectedPages.Count == 0) return;

        try
        {
            isProcessing = true;
            errorMessage = null;
            extractionResult = null;

            var extractedText = PdfService.ExtractTextFromPages(new MemoryStream(pdfBytes), selectedPages);
            extractionResult = await AiService.ExtractTablesAsync(extractedText);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al procesar con IA: {ex.Message}. Asegúrese de configurar su API Key de OpenAI.";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task DownloadExcel()
    {
        if (extractionResult == null) return;

        try
        {
            var excelBytes = ExcelService.ExportToExcel(extractionResult);
            var fileName = $"Tablas_Extraidas_{DateTime.Now:yyyyMMddHHmmss}.xlsx";
            await JS.InvokeVoidAsync("saveAsFile", fileName, Convert.ToBase64String(excelBytes));
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al generar Excel: {ex.Message}";
        }
    }
}
